{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiny Shrooms Spore Siege",
  "version": "0.1.2",
  "identifier": "fr.magicelian.sporesiege",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tiny Shrooms: Spore Siege",
        "width": 480,
        "height": 480,
        "transparent": true,
        "acceptFirstMouse": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/barre-menus.png",
      "iconAsTemplate": true,
      "tooltip": "Spore Siege"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4NkI1MTU0RUMzNkEyN0IKUldSN29qYnNWRkZyT0ptcFN1RXJsY0FQSm94bjNpTVJib1Z5ekJrejVsK2ZDNzNyNG1OQUloekMK",
      "endpoints": [
        "https://github.com/Magicelian/spore-siege/releases/latest/download/latest.json"
      ]
    }
  }
}
